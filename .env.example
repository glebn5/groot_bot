# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ

# Allowed Telegram User IDs (comma-separated integers)
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# Groq API Key (used for Whisper STT and Llama LLM / Vision)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Generative AI API Key (Optional Gemini fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# WebDAV Configuration (Mail.ru Cloud WebDAV)
WEBDAV_HOSTNAME=https://webdav.cloud.mail.ru
WEBDAV_LOGIN=your_email@mail.ru
WEBDAV_PASSWORD=your_app_password
WEBDAV_VAULT_PATH=/Vault

# Google Calendar Integration
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# Local SQLite Database Path
DATABASE_PATH=data/scheduler.db

# Path to Obsidian To-Do Template file inside container
TEMPLATE_PATH=To-Do template.md

# Timezone Configuration
TIMEZONE=Europe/Moscow
TZ=Europe/Moscow

# Quiet Hours / Night Mode Configuration
ALLOW_NIGHT_NOTIFICATIONS=False
QUIET_HOURS_START=23:00
QUIET_HOURS_END=08:00

